@model LandingVm
@{ ViewData["Title"] = "首頁"; }

<section class="hero">
    <div>
        <p class="eyebrow">初等・高普考・地方特考・郵局・中華電信</p>
        <h1>把考古題做熟，<br />把<em>錯題</em>變成分數。</h1>
        <p class="lead-muted">備考簿收錄考選部公開的歷屆測驗題與標準答案，整理各考試的考期與應試科目，並記錄你的讀書時數與錯題，讓準備進度看得見。</p>
        <div class="stat-row">
            <div><strong>@Model.QuestionCount.ToString("N0")</strong><span>官方試題</span></div>
            <div><strong>@Model.PaperCount</strong><span>份試卷</span></div>
            <div><strong>@Model.ExamCount</strong><span>種考試資訊</span></div>
        </div>
        <a class="btn btn-ink btn-lg" asp-controller="Account" asp-action="Register">免費註冊開始練習</a>
        <a class="btn btn-line btn-lg ms-2" asp-controller="Practice" asp-action="Index">先看題庫</a>
    </div>
    <div class="answer-card" aria-hidden="true">
        <div class="d-flex justify-content-between mb-2"><span class="serif fw-bold">練習答案卡</span><span class="pill pill-red">紅筆批改</span></div>
        @{ var demo = new[] { (2, -1), (0, -1), (3, 1), (1, -1), (2, -1) }; int i = 1; }
        @foreach (var (pick, wrong) in demo)
        {
            <div class="row-label num">第 @(i++) 題</div>
            <div class="bubbles">
                @for (var k = 0; k < 4; k++)
                {
                    var cls = k == pick ? "filled" : k == wrong ? "wrong" : "";
                    <span class="bubble @cls">@("ABCD"[k])</span>
                }
            </div>
        }
    </div>
</section>

<section class="mt-3">
    <div class="sheet-title"><h2>近期考試</h2><a asp-controller="Calendar" asp-action="Index">完整行事曆 →</a></div>
    <div class="countdown-list">
        @foreach (var c in Model.Upcoming) { <partial name="_Countdown" model="c" /> }
    </div>
</section>

<section class="feature-grid mt-4">
    <div class="sheet"><h3>題庫練習</h3><p class="mb-0 text-muted">整卷作答或依科目跨年度隨機抽題，交卷後立即批改並標出正解。</p></div>
    <div class="sheet"><h3>錯題本</h3><p class="mb-0 text-muted">答錯自動收錄；同一題連續答對 2 次就標為熟練，可寫下自己的筆記。</p></div>
    <div class="sheet"><h3>讀書計畫</h3><p class="mb-0 text-muted">為每科設定目標時數，記錄每天讀了多久，近 14 天一眼看出偏科。</p></div>
    <div class="sheet"><h3>考期倒數</h3><p class="mb-0 text-muted">設定目標考試，首頁倒數報名截止與考試日，也能匯出到行事曆 App。</p></div>
</section>
