@model LandingVm
@{
    ViewData["Title"] = "首頁";
    var next = Model.Upcoming.FirstOrDefault();
    string[] hot = ["行政學", "法學知識與英文", "國文", "郵政三法", "計算機概論", "行政法"];
}

<section class="hero">
    <div>
        <h1>公職考古題，<br />一題一題刷到會。</h1>
        <p class="hero-lead">收錄 @Model.ExamCount 類考試的歷屆試題：高普考、地特、初等、司法、警察、關務、鐵路、專技與醫事人員，以及國營事業招考。選擇題附官方答案，答錯自動進錯題本；申論題可以閱讀、寫筆記和討論。</p>
        <form class="hero-search" method="get" asp-controller="Practice" asp-action="Index" role="search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7f918c" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input name="q" type="search" placeholder="輸入科目，例如：行政學、計算機概論" aria-label="搜尋科目" />
            <button class="btn btn-ink" type="submit">找考古題</button>
        </form>
        <div class="hot">
            <span>常搜尋</span>
            @foreach (var h in hot)
            {
                <a asp-controller="Practice" asp-action="Index" asp-route-q="@h">@h</a>
            }
        </div>
        <div class="hero-facts">
            <div><strong>@Model.QuestionCount.ToString("N0")</strong> 題選擇題</div>
            <div><strong>@Model.EssayCount.ToString("N0")</strong> 題申論題</div>
            <div><strong>@Model.PaperCount.ToString("N0")</strong> 份試卷</div>
            <div>每題附<strong> 原卷 PDF</strong> 連結</div>
        </div>
    </div>

    <div class="try-card">
        @if (next is not null)
        {
            <div class="try-head">
                <div>
                    <div class="label">下一場考試</div>
                    <div class="title">@next.Session.Title</div>
                    <div class="label">@TaipeiDate.RocWithWeekday(next.Session.ExamStart)@(next.Session.IsTentative ? "（暫定）" : "")</div>
                </div>
                <div class="days"><strong>@next.DaysToExam</strong><span>天後</span></div>
            </div>
        }
        @if (Model.Sample is { } q)
        {
            <div class="try-body" id="try" data-answer="@q.Answer">
                <div class="src">試試看・@q.Paper!.RocYear 年 @q.Paper.SubjectName @q.Label</div>
                <div class="stem">@QuestionText.Render(q.Stem)</div>
                @foreach (var (letter, text) in q.Options())
                {
                    <button type="button" class="try-opt" data-letter="@letter"><span class="letter">@letter</span><span>@QuestionText.Render(text)</span></button>
                }
                <div class="try-result" aria-live="polite"></div>
            </div>
        }
    </div>
</section>

<section class="section">
    <h2>選擇你要考的</h2>
    @foreach (var grp in Model.ExamStats.GroupBy(s => s.Exam.Group))
    {
    <h3 class="exam-group-title">@(string.IsNullOrEmpty(grp.Key) ? "其他" : grp.Key)</h3>
    <div class="exam-grid">
        @foreach (var e in grp)
        {
            <a class="exam-card" asp-controller="Practice" asp-action="Index" asp-route-exam="@e.Exam.Slug">
                <div class="org">@e.Exam.Organizer</div>
                <h3>@e.Exam.ShortName</h3>
                @if (e.Papers > 0 && e.Questions + e.Essays == 0)
                {
                    <div class="count"><small>只列原卷連結</small></div>
                    <div class="years">@(e.FirstYear == e.LastYear ? $"{e.FirstYear} 年" : $"{e.FirstYear}–{e.LastYear} 年")・@e.Papers.ToString("N0") 份試卷</div>
                }
                else if (e.Papers > 0)
                {
                    <div class="count">@((e.Questions + e.Essays).ToString("N0")) <small>題</small></div>
                    <div class="years">@(e.FirstYear == e.LastYear ? $"{e.FirstYear} 年" : $"{e.FirstYear}–{e.LastYear} 年")・@e.Papers.ToString("N0") 份試卷</div>
                }
                else
                {
                    <div class="count"><small>尚無公開試題</small></div>
                }
            </a>
        }
    </div>
    }
</section>

<section class="section">
    <h2>近期考試</h2>
    <div class="countdown-list">
        @foreach (var c in Model.Upcoming) { <partial name="_Countdown" model="c" /> }
    </div>
    <p class="mt-3"><a asp-controller="Calendar" asp-action="Index">看完整考試行事曆</a></p>
</section>

<section class="section">
    <h2>註冊後可以做的事</h2>
    <div class="feature-grid">
        <div class="sheet"><h3>整卷或隨機刷題</h3><p class="mb-0 text-muted">整份歷屆試卷作答，或選一科跨年度隨機抽題，交卷立即批改。</p></div>
        <div class="sheet"><h3>錯題本</h3><p class="mb-0 text-muted">答錯自動收錄，同一題連續答對 2 次就算熟練，還能寫自己的筆記。</p></div>
        <div class="sheet"><h3>讀書計畫</h3><p class="mb-0 text-muted">每科設目標時數，每天記錄讀了多久，偏科一看就知道。</p></div>
        <div class="sheet"><h3>考試倒數</h3><p class="mb-0 text-muted">把要考的設成目標，首頁倒數報名截止和考試日。</p></div>
    </div>
    <a class="btn btn-ink btn-lg mt-4" asp-controller="Account" asp-action="Register">免費註冊</a>
</section>

@section Scripts {
<script>
(function () {
    const box = document.getElementById('try');
    if (!box) return;
    const answer = box.dataset.answer;
    const result = box.querySelector('.try-result');
    box.querySelectorAll('.try-opt').forEach(btn => btn.addEventListener('click', () => {
        const pick = btn.dataset.letter;
        box.querySelectorAll('.try-opt').forEach(b => {
            b.disabled = true;
            if (b.dataset.letter === answer) b.classList.add('is-answer');
        });
        if (pick !== answer) btn.classList.add('is-wrong');
        result.textContent = pick === answer ? '答對了！註冊後可以繼續刷整份試卷。' : `正解是 ${answer}。註冊後答錯的題目會自動收進錯題本。`;
        result.style.color = pick === answer ? 'var(--green)' : 'var(--red)';
    }));
})();
</script>
}
