@model List<ErrataReport>
@{
    ViewData["Title"] = "勘誤回報";
    var status = (ErrataStatus)ViewBag.Status;
    string[] kinds = ["題目文字", "選項文字", "答案", "AI 詳解", "其他"];
}
<p class="eyebrow mb-1"><a asp-action="Index">管理</a></p>
<h1>勘誤回報</h1>
<nav class="d-flex gap-2 mb-3">
    <a class="pill @(status == ErrataStatus.Open ? "pill-red" : "")" asp-route-status="@ErrataStatus.Open">待處理</a>
    <a class="pill @(status == ErrataStatus.Resolved ? "pill-red" : "")" asp-route-status="@ErrataStatus.Resolved">已修正</a>
    <a class="pill @(status == ErrataStatus.Rejected ? "pill-red" : "")" asp-route-status="@ErrataStatus.Rejected">不成立</a>
</nav>
<p class="small text-muted">請對照原卷確認。題目或答案確實有誤時，應修正解析程式或排除該題後重建題庫包；AI 詳解有誤時按「已修正」會刪除快取，讓下次重新產生。</p>
@if (Model.Count == 0) { <div class="empty sheet">沒有資料。</div> }
@foreach (var e in Model)
{
    var q = e.Question!;
    <div class="sheet">
        <div class="d-flex justify-content-between gap-2 flex-wrap">
            <div><span class="pill">@kinds[(int)e.Kind]</span> <a asp-controller="Question" asp-action="Detail" asp-route-id="@q.Id">@q.Paper!.RocYear 年 @q.Paper.SubjectName 第 @q.Number 題</a></div>
            <span class="small text-muted">@TaipeiDate.ToTaipeiTime(e.CreatedAt).ToString("yyyy/MM/dd HH:mm")</span>
        </div>
        <p class="my-2" style="white-space:pre-wrap">@e.Detail</p>
        <p class="small mb-2"><a href="@q.Paper!.SourceQuestionUrl" target="_blank" rel="noopener">原卷</a>　<a href="@q.Paper!.SourceAnswerUrl" target="_blank" rel="noopener">答案</a></p>
        @if (e.Status == ErrataStatus.Open)
        {
            <form asp-action="ResolveErrata" asp-route-id="@e.Id" method="post" class="d-flex gap-2 flex-wrap">
                <input class="form-control form-control-sm" style="max-width:24rem" name="note" placeholder="處理說明（選填）" />
                <button class="btn btn-sm btn-ink" name="status" value="@ErrataStatus.Resolved">已修正</button>
                <button class="btn btn-sm btn-line" name="status" value="@ErrataStatus.Rejected">不成立</button>
            </form>
        }
        else if (!string.IsNullOrEmpty(e.AdminNote))
        {
            <p class="small text-muted mb-0">處理說明：@e.AdminNote</p>
        }
    </div>
}
