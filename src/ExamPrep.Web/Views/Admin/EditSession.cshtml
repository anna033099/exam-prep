@model SessionInput
@{
    ViewData["Title"] = Model.Id is null ? "新增考期" : "編輯考期";
    var exams = (List<Exam>)ViewBag.Exams;
}
<p class="eyebrow mb-1"><a asp-action="Index">管理</a></p>
<h1>@ViewData["Title"]</h1>
<form asp-action="EditSession" method="post" class="sheet" style="max-width:44rem">
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row g-2">
        <div class="col-md-5 mb-2">
            <label asp-for="ExamId" class="form-label"></label>
            <select asp-for="ExamId" class="form-select">
                @foreach (var e in exams) { <option value="@e.Id">@e.ShortName</option> }
            </select>
        </div>
        <div class="col-md-7 mb-2">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" placeholder="例如：116年中華郵政職階人員甄試" />
        </div>
        <div class="col-md-6 mb-2"><label asp-for="RegistrationStart" class="form-label"></label><input asp-for="RegistrationStart" type="date" class="form-control" /></div>
        <div class="col-md-6 mb-2"><label asp-for="RegistrationEnd" class="form-label"></label><input asp-for="RegistrationEnd" type="date" class="form-control" /></div>
        <div class="col-md-6 mb-2"><label asp-for="ExamStart" class="form-label"></label><input asp-for="ExamStart" type="date" class="form-control" /></div>
        <div class="col-md-6 mb-2"><label asp-for="ExamEnd" class="form-label"></label><input asp-for="ExamEnd" type="date" class="form-control" /></div>
        <div class="col-12 mb-2 form-check ms-1"><input asp-for="IsTentative" class="form-check-input" /><label asp-for="IsTentative" class="form-check-label"></label></div>
        <div class="col-12 mb-2"><label asp-for="Note" class="form-label"></label><input asp-for="Note" class="form-control" /></div>
        <div class="col-md-5 mb-2"><label asp-for="SourceName" class="form-label"></label><input asp-for="SourceName" class="form-control" placeholder="例如：中華郵政 116 年甄試簡章" /></div>
        <div class="col-md-7 mb-3"><label asp-for="SourceUrl" class="form-label"></label><input asp-for="SourceUrl" class="form-control" placeholder="https://" /></div>
    </div>
    <button class="btn btn-ink" type="submit">儲存</button>
    <a class="btn btn-line" asp-action="Index">取消</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
