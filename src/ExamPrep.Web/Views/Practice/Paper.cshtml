@model QuestionPaper
@inject Microsoft.AspNetCore.Identity.SignInManager<ApplicationUser> SignIn
@{
    ViewData["Title"] = Model.SubjectName;
    var excluded = (List<SeedDataService.ExcludedSeed>)ViewBag.Excluded;
    var count = (int)ViewBag.Count;
    var essays = (List<Question>)ViewBag.Essays;
}
<p class="eyebrow mb-1"><a asp-action="Index">題庫</a> ／ @Model.RocYear 年</p>
<h1>@Model.SubjectName</h1>
<p class="lead-muted">@Model.RocYear 年 @Model.ExamTitle</p>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="sheet">
            <table class="table-paper">
                <tr><td class="text-muted">試題代號</td><td class="num">@Model.PaperCode</td></tr>
                <tr><td class="text-muted">適用類科</td><td>@Model.Categories</td></tr>
                @if (Model.OfficialQuestionCount > 0)
                {
                    <tr><td class="text-muted">選擇題</td><td>收錄 <span class="num">@count</span> ／ 官方 <span class="num">@Model.OfficialQuestionCount</span> 題</td></tr>
                }
                @if (essays.Count > 0)
                {
                    <tr><td class="text-muted">申論題</td><td><span class="num">@essays.Count</span> 題（沒有官方標準答案，不計分）</td></tr>
                }
                <tr><td class="text-muted">原始檔案</td><td>
                    @if (string.IsNullOrEmpty(Model.SourceAnswerUrl))
                    {
                        <a href="@Model.SourceQuestionUrl" target="_blank" rel="noopener">試題 PDF </a>
                    }
                    else if (Model.SourceAnswerUrl == Model.SourceQuestionUrl)
                    {
                        <a href="@Model.SourceQuestionUrl" target="_blank" rel="noopener">試題與答案 PDF </a>
                    }
                    else
                    {
                        <a href="@Model.SourceQuestionUrl" target="_blank" rel="noopener">試題 PDF </a><span>　</span><a href="@Model.SourceAnswerUrl" target="_blank" rel="noopener">標準答案 PDF </a>
                    }
                </td></tr>
            </table>
            @if (!string.IsNullOrWhiteSpace(Model.SourceNote))
            {
                <p class="small mt-3 mb-0"><strong>來源說明：</strong>@Model.SourceNote</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.AnswerNote))
            {
                <p class="small mt-3 mb-0"><strong>答案備註：</strong>@Model.AnswerNote</p>
            }
            <div class="mt-3">
                @if (Model.ContentWithheld)
                {
                    <p class="flash mb-0">公開版不提供這份試卷的題目內文（非考選部辦理的考試，試題著作權屬主辦單位），請由上方原始檔案連結查看。</p>
                }
                else if (count == 0)
                {
                    <p class="text-muted mb-0">這份試卷沒有可作答的選擇題，申論題請看下方。</p>
                }
                else if (SignIn.IsSignedIn(User))
                {
                    <div class="d-flex gap-2 flex-wrap">
                        <form asp-action="StartPaper" method="post">
                            <input type="hidden" name="paperId" value="@Model.Id" />
                            <button class="btn btn-ink" type="submit">整卷作答（@count 題）</button>
                        </form>
                        <form asp-action="StartPaper" method="post">
                            <input type="hidden" name="paperId" value="@Model.Id" />
                            <input type="hidden" name="mode" value="instant" />
                            <button class="btn btn-line" type="submit">逐題對答</button>
                        </form>
                        <form asp-action="StartPaper" method="post" class="d-flex gap-1 align-items-center">
                            <input type="hidden" name="paperId" value="@Model.Id" />
                            <input type="hidden" name="mode" value="exam" />
                            <button class="btn btn-line" type="submit">計時模擬考</button>
                            <input class="form-control form-control-sm" style="width:4.5rem" type="number" name="minutes" value="60" min="5" max="300" aria-label="分鐘" /><span class="small text-muted">分</span>
                        </form>
                    </div>
                }
                else
                {
                    <a class="btn btn-ink" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"/Practice/Paper/{Model.Id}")">登入後作答</a>
                }
                @if ((int)ViewBag.ZipCount > 1)
                {
                    <p class="small mt-3 mb-0"><a asp-controller="Download" asp-action="Subject" asp-route-subject="@Model.SubjectName" asp-route-exam="@Model.Exam?.Slug">下載「@Model.SubjectName」歷年原卷 ZIP（@Math.Min((int)ViewBag.ZipCount, PaperZipService.MaxPapers) 份試題＋答案）</a></p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="sheet">
            <h2 class="h5">未收錄的題目</h2>
            @if (excluded.Count == 0)
            {
                <p class="text-muted mb-0">本卷所有題目皆已收錄。</p>
            }
            else
            {
                <p class="small text-muted">以下題目無法以純文字完整還原，為避免錯誤而不收錄，請直接看原始 PDF。</p>
                <table class="table-paper">
                    @foreach (var e in excluded)
                    {
                        <tr><td class="num">@(e.No > Question.EssayNumberBase ? $"申論第{Question.CnNumber(e.No - Question.EssayNumberBase)}題" : $"第 {e.No} 題")</td><td class="small">@e.Reason</td></tr>
                    }
                </table>
            }
        </div>
    </div>
</div>

@if (essays.Count > 0)
{
    <div class="sheet mt-3" id="essays">
        <div class="sheet-title"><h2>申論題</h2><span class="pill">不計分</span></div>
        <p class="small text-muted">文字逐行取自原卷並與原卷比對過；標示 ⚠ 的題目含圖表或特殊符號，請對照原卷 PDF。點題號可以寫筆記、討論或看 AI 參考解答。</p>
        @foreach (var e in essays)
        {
            <div class="essay-item">
                <a class="fw-bold" asp-controller="Question" asp-action="Detail" asp-route-id="@e.Id">@e.Label</a>
                @if (!string.IsNullOrEmpty(e.Remark)) { <span class="small text-warning-emphasis ms-2">⚠ @e.Remark</span> }
                <div class="essay-text">@QuestionText.Render(e.Stem)</div>
            </div>
        }
    </div>
}
