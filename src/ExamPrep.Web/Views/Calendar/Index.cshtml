@model CalendarVm
@{
    ViewData["Title"] = "考試行事曆";
    string[] orgs = ["考選部", "中華郵政", "中華電信"];
}
<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <h1 class="mb-1">考試行事曆</h1>
        <p class="lead-muted mb-0">倒數以台灣時間計算。標「暫定」者為官方計畫表的預定日期，請以正式簡章為準。</p>
    </div>
    <a class="btn btn-line" asp-action="Ics" title="可匯入 Google 日曆、Outlook、iPhone 行事曆">
        ⤓ 匯出 .ics@(Model.LoggedIn ? "（我的目標）" : "")
    </a>
</div>

<nav class="d-flex gap-2 flex-wrap mb-3" aria-label="主辦單位">
    <a class="pill @(Model.Organizer is null ? "pill-red" : "")" asp-action="Index">全部</a>
    @foreach (var o in orgs)
    {
        <a class="pill @(Model.Organizer == o ? "pill-red" : "")" asp-action="Index" asp-route-organizer="@o">@o</a>
    }
</nav>

@if (!Model.LoggedIn)
{
    <p class="small text-muted"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Calendar">登入</a>後可把考試設為目標，首頁會顯示倒數。</p>
}

<h2 class="mt-3">即將到來</h2>
@if (Model.Upcoming.Count == 0)
{
    <p class="empty">目前沒有已公告的考期。</p>
}
<div class="countdown-list">
    @foreach (var c in Model.Upcoming) { <partial name="_Countdown" model="c" /> }
</div>

@if (Model.Past.Count > 0)
{
    <details class="mt-4">
        <summary class="h5 serif">已結束的考期（@Model.Past.Count）</summary>
        <p class="small text-muted mt-2">保留往年日期，方便推估下一次大約何時公告。</p>
        <div class="countdown-list">
            @foreach (var c in Model.Past) { <partial name="_Countdown" model="c" /> }
        </div>
    </details>
}
