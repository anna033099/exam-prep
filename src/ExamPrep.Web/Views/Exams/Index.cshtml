@model List<Exam>
@{
    ViewData["Title"] = "考試資訊";
    var counts = (Dictionary<int, int>)ViewBag.PaperCounts;
}
<h1>考試資訊</h1>
<p class="lead-muted">各考試的性質、應試科目與考期。國家考試由考選部辦理；國營事業、證照與其他招考由各機關或公司自辦，報考資格與錄取方式不同。</p>

@foreach (var group in Model.GroupBy(e => e.Group))
{
    <h2 class="mt-4">@(string.IsNullOrEmpty(group.Key) ? "其他" : group.Key)</h2>
    <div class="feature-grid">
        @foreach (var e in group)
        {
            var papers = counts.GetValueOrDefault(e.Id);
            <a class="sheet text-decoration-none text-reset d-block" asp-action="Detail" asp-route-slug="@e.Slug">
                <div class="d-flex justify-content-between align-items-start">
                    <h3 class="mb-1">@e.ShortName</h3>
                    <span class="pill">@e.Organizer</span>
                </div>
                <p class="small text-muted mb-2">@e.Name</p>
                <p class="small mb-2">@e.Summary</p>
                <span class="small text-muted">@(papers > 0 ? $"題庫 {papers:N0} 份試卷" : "尚無公開試題")@(e.Sessions.Count > 0 ? $"・考期 {e.Sessions.Count} 筆" : "")</span>
            </a>
        }
    </div>
}
